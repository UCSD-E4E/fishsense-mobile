# Uncomment this line to define a global platform for your project
platform :ios, "17.0"

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 17.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      end

      # permission_handler compiles in only the permissions whose macros
      # are defined here. Without these, request() silently no-ops and the
      # iOS system prompt never appears. Mirror Info.plist usage keys.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
      ]
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
      ]
    end
  end

  # Inject a Run Script build phase into the Runner target so that the
  # Rust bridge is compiled (via rust-bridge/Makefile) before every iOS build.
  # This phase is idempotent: it is only added once even across repeated
  # `pod install` runs.
  runner_project = installer.aggregate_targets
    .find { |t| t.name == 'Pods-Runner' }
    &.user_project

  if runner_project
    runner_target = runner_project.targets.find { |t| t.name == 'Runner' }

    if runner_target
      phase_name = 'Build Rust Bridge'
      unless runner_target.shell_script_build_phases.any? { |p| p.name == phase_name }
        phase = runner_target.new_shell_script_build_phase(phase_name)
        phase.shell_script = 'cd "${SRCROOT}/../rust-bridge" && make'
        phase.show_env_vars_in_log = '0'
        # Place this phase before Compile Sources so the .a library is ready
        runner_target.build_phases.delete(phase)
        runner_target.build_phases.unshift(phase)
        runner_project.save
      end

      # Re-sign every framework Flutter's native-assets build hook drops into
      # Runner.app/Frameworks/. Those land ad-hoc signed (Signature=adhoc,
      # TeamIdentifier=not set), which iOS 26+ rejects on device install with
      # MIInstallerErrorDomain code 13 (0xe8008014 invalid signature). The
      # standard CocoaPods/Xcode signing flow doesn't touch them because they
      # come in via xcode_backend.sh, not the Embed Frameworks phase.
      sign_phase_name = 'Re-sign Native Assets'
      unless runner_target.shell_script_build_phases.any? { |p| p.name == sign_phase_name }
        sign_phase = runner_target.new_shell_script_build_phase(sign_phase_name)
        sign_phase.shell_script = <<~SH
          set -e
          if [ -z "${EXPANDED_CODE_SIGN_IDENTITY:-}" ]; then
            echo "Re-sign Native Assets: no signing identity, skipping"
            exit 0
          fi
          FRAMEWORKS_DIR="${BUILT_PRODUCTS_DIR}/${WRAPPER_NAME}/Frameworks"
          [ -d "$FRAMEWORKS_DIR" ] || exit 0
          for fw in "$FRAMEWORKS_DIR"/*.framework; do
            [ -d "$fw" ] || continue
            if /usr/bin/codesign -dvv "$fw" 2>&1 | grep -q "Signature=adhoc"; then
              echo "Re-signing $(basename "$fw")"
              # Do NOT preserve `flags`: that would keep the 0x2(adhoc)
              # bit and the resign would be a no-op.
              /usr/bin/codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" \\
                --preserve-metadata=identifier,entitlements \\
                --generate-entitlement-der \\
                --timestamp=none \\
                "$fw"
            fi
          done
        SH
        sign_phase.show_env_vars_in_log = '0'
        # Must run AFTER xcode_backend.sh embeds the frameworks. Append to end.
        runner_target.build_phases.delete(sign_phase)
        runner_target.build_phases << sign_phase
        runner_project.save
      end
    end
  end
end
